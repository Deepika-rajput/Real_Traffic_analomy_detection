# Copy values into your shell (PowerShell: $env:NAME="value") before starting the server.
# MOCK_DETECTOR=1            # fake detector, for UI work without a trained model
# MOCK_SCRIPT=accident:5-10,congestion:20-30
# API_KEY=change-me          # require X-API-Key (or ?key=) on /api/*
# SEND_MODE=dry_run          # dry_run (default, writes .eml files) | smtp
# TEST_RECIPIENT=you@gmail.com   # while testing, EVERY email goes here instead of the authority
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=you@gmail.com
# SMTP_PASS=app-password
# MAIL_FROM=you@gmail.com
# PUBLIC_BASE_URL=http://localhost:8000   # used in links inside emails
# PRE_ROLL_S=8   POST_ROLL_S=6   COOLDOWN_S=90
# HIGH_PROB=0.90 MED_PROB=0.75
# MAX_RADIUS_KM=50   ACK_TIMEOUT_MIN=10
